# Copy to `.env` and fill in. `.env` is gitignored; THIS file is committed, so
# never put a real value in it.
#
# ---------------------------------------------------------------------------
# PUBLIC — safe in the browser
# ---------------------------------------------------------------------------
# From: Firebase console -> Project settings -> General -> Your apps -> Web app
#
# Only VITE_-prefixed variables are exposed to client code, and these are meant
# to be. They name the project so requests route to it; they authenticate
# nothing. The Firestore security rules protect the data.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. reCAPTCHA v3 site key — the public half of the anti-spam control.
VITE_RECAPTCHA_SITE_KEY=

# ---------------------------------------------------------------------------
# SECRET — server-side only. NEVER give these a VITE_ prefix.
# ---------------------------------------------------------------------------
# The VITE_ prefix is what tells Vite to inline a value into the browser
# bundle. Prefixing the line below would publish your database to every visitor.
# `npm run build` scans the bundle and fails if that ever happens.

# Your service-account key, base64-encoded onto a single line (a .env file
# cannot hold the raw JSON: its private_key contains real newlines).
#
#   Firebase console -> Project settings -> Service accounts
#     -> Generate new private key
#
#   macOS:  base64 -i ~/Downloads/key.json | tr -d '\n' | pbcopy
#   Linux:  base64 -w0 key.json
#
# Paste the same value into Netlify -> Site configuration -> Environment
# variables. Raw JSON also works there, where newlines survive.
FIREBASE_SERVICE_ACCOUNT=

# Optional. The secret half of reCAPTCHA v3; leave blank to skip the check.
RECAPTCHA_SECRET_KEY=
