rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isChurchAttendanceAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/church-attendance-admins/$(request.auth.uid));
    }

    match /church-attendance-members/{memberId} {
      allow read, write: if isChurchAttendanceAdmin();
    }
    match /church-attendance-records/{recordId} {
      allow read: if isChurchAttendanceAdmin();
      // Public check-ins are written server-side with the Admin SDK, which
      // bypasses these rules. Admins may also record a check-in by hand (e.g.
      // for someone present while the public window is closed), so allow them.
      allow write: if isChurchAttendanceAdmin();
    }
    match /church-attendance-config/{docId} {
      allow read, write: if isChurchAttendanceAdmin();
    }
    match /church-attendance-admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /church-attendance-rate-limits/{key} {
      allow read, write: if false;
    }
    match /church-attendance-disputes/{key} {
      // "That isn't my name" reports. Written server-side with the Admin SDK,
      // which bypasses these rules; admins read them and mark them resolved.
      allow read, write: if isChurchAttendanceAdmin();
    }

    // ← your other app's existing rules stay here, untouched

  }
}